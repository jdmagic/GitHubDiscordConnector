# All configuration lives here. Copy to .env and fill in; .env is gitignored, so never commit real values.
# Lines marked "optional" can be left blank to use the default.

# --- Project ---

# Repo(s) whose merged PRs count, as owner/name. Comma-separate to count across several.
GITHUB_REPOS=boykopovar/AnyPS5

# Optional. Public repos work without a token, at lower rate limits
# (60 user lookups/hour, 10 searches/minute per IP). Required for private repos.
GITHUB_TOKEN=

# --- Discord app (Developer Portal) ---

# OAuth2 page.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bot -> Reset Token. Only used by `npm run register` to publish the metadata schema;
# no bot process runs and the bot doesn't need to be in your server.
DISCORD_BOT_TOKEN=

# Must exactly match a redirect added under OAuth2 -> Redirects.
DISCORD_REDIRECT_URI=http://localhost:3000/discord-oauth-callback

# Optional. Label on members' profile badge. Default: GitHub
DISCORD_PLATFORM_NAME=

# --- Server ---

# Optional. Port to listen on. Default: 3000. Hosting platforms usually set this.
PORT=

# Random string used to sign the OAuth state cookie, e.g. `openssl rand -hex 32`.
COOKIE_SECRET=
