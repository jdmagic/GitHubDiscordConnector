# Copy to .env and fill in. .env is gitignored — never commit real values.

# Discord Developer Portal -> your app -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord Developer Portal -> your app -> Bot -> Reset Token.
# Only used by `npm run register` to publish the metadata schema; no bot process runs.
DISCORD_BOT_TOKEN=

# Must exactly match a redirect added under OAuth2 -> Redirects.
DISCORD_REDIRECT_URI=http://localhost:3000/discord-oauth-callback

# GitHub fine-grained token. No extra permissions needed for public repos;
# give it read-only "Pull requests" access if the repo is private.
GITHUB_TOKEN=

# Random string used to sign the OAuth state cookie, e.g. `openssl rand -hex 32`.
COOKIE_SECRET=
