{
  "name": "anyps5-discord-verification",
  "version": "0.1.0",
  "private": true,
  "description": "Discord Linked Roles app that grants a role to users with merged PRs in a GitHub project",
  "type": "module",
  "engines": {
    "node": ">=21.7"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "register": "tsx src/register.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
